{
  "name": "studio-ops-bot",
  "version": "0.1.0",
  "description": "Discord operations bot for a creative production studio: staff directory, timezones, projects, task assignment, submissions, client approval records and payment tracking.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "deploy": "node src/deploy-commands.js",
    "test": "node --test tests/*.test.js",
    "web": "node web/server.js",
    "site": "node web/export-static.js",
    "reference": "node docs/reference/build.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "node-cron": "^4.6.0"
  }
}
