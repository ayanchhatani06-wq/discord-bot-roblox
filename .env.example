# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID, from the same page as the token
CLIENT_ID=

# Optional: set this during development to register slash commands to a
# single guild instantly instead of globally (global registration can take
# up to an hour to propagate).
GUILD_ID=

# How often (in minutes) the live time embed refreshes. Keep this at 1 for
# an always-accurate clock; raise it if you have many servers using the bot.
UPDATE_INTERVAL_MINUTES=1
