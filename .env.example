# Copy to .env and fill in. Never commit the real .env.

# Bot token from https://discord.com/developers/applications (Bot tab).
DISCORD_TOKEN=

# Application (client) ID, from the same application's General Information tab.
CLIENT_ID=

# Optional: your server's ID. Set this during setup so slash commands register
# instantly to that one server instead of waiting for global propagation.
GUILD_ID=

# Where the SQLite database lives. Defaults to ./data/studio.db.
# Back this file up: it holds every profile, task, approval and payment record.
DATABASE_FILE=

# Everything else - departments, role mappings, channels, reminder intervals,
# quiet hours and the payment split percentages - is configured in Discord via
# the setup command and stored in the database, not here.

# --- The website (optional; only needed if you run it) ---

# Which server the site is showing. Defaults to GUILD_ID above.
WEB_GUILD_ID=

# The port the site listens on. Default 8080.
WEB_PORT=

# The public address the live site is reached at, e.g. https://app.example.com.
# Used to build sign-in links, and to point the static site's quote form at a
# server that can receive it.
WEB_APP_URL=

# Set to 1 ONLY when a reverse proxy (Caddy, nginx, Cloudflare) really is in
# front and sets X-Forwarded-For. Without a proxy, leave this unset: anybody
# can send that header, and believing it lets one sender walk past the rate
# limits by changing it on every request.
TRUST_PROXY=

# Set to 1 ONLY for local testing over plain http. It stops session cookies
# being marked Secure, which a browser would otherwise refuse to send.
WEB_INSECURE=

# Where the static export writes to. Defaults to ./data/site.
SITE_OUT=

# An invite shown on the static quote page when there is no live site to post
# a form to.
DISCORD_INVITE=

# Where /backup now writes. Defaults to ./data/backups.
BACKUP_DIR=

# --- Optional: sign in with Discord (the website) ---
# Both must be set, plus WEB_APP_URL, or the button simply does not appear.
# Add <WEB_APP_URL>/client/discord/callback as a redirect URI in the Discord
# developer portal under OAuth2. Only the "identify" scope is requested.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Optional: email sign-in links instead of handing them over ---
# Without these the link is still generated; a staff member sends it, which is
# what /web sign-in-link is for.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Where the static export should say the site lives, e.g.
# https://cylops-studio.freedev.app. Only used to write sitemap.xml.
SITE_URL=
